generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum estado_membresia {
  PENDIENTE_PAGO
  ACTIVO
  VENCIDO
  SUSPENDIDO
}

enum estado_reserva_clase {
  CONFIRMADA
  CANCELADA
}

enum estado_lista_espera {
  EN_ESPERA
  NOTIFICADO
  CONVERTIDO
  CANCELADO
}

enum estado_cancha {
  HABILITADA
  EN_MANTENIMIENTO
}

enum estado_reserva_cancha {
  PENDIENTE_PAGO
  CONFIRMADA
  CANCELADA
}

enum estado_pago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model rol {
  id_rol    Int       @id @default(autoincrement())
  clase_rol String    @unique @db.VarChar(50)
  usuario   usuario[]
}

model sede {
  id           Int       @id @default(autoincrement())
  nombre       String    @unique @db.VarChar(150)
  direccion    String    @db.VarChar(200)
  localidad    String    @db.VarChar(100)
  aforo_maximo Int
  creada_at    DateTime  @default(now()) @db.Timestamptz(6)

  usuario usuario[]
  acceso  acceso[]
  cancha  cancha[]
  clase   clase[]
}

model usuario {
  id            Int       @id @default(autoincrement())
  dni           String    @unique @db.VarChar(20)
  nombre        String    @db.VarChar(100)
  apellido      String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  telefono      String?   @db.VarChar(30)
  foto_url      String?
  password_hash String    @db.VarChar(255)
  id_rol        Int
  sede_base_id  Int?
  creado_at     DateTime  @default(now()) @db.Timestamptz(6)

  rol       rol   @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  sede_base sede? @relation(fields: [sede_base_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  credencial_qr      credencial_qr?
  instructor         instructor?
  membresia          membresia[]
  acceso             acceso[]
  reserva_clase      reserva_clase[]
  lista_espera_clase lista_espera_clase[]
  reserva_cancha     reserva_cancha[]

  @@index([id_rol], map: "ix_usuario_id_rol")
  @@index([sede_base_id], map: "ix_usuario_sede_base_id")
}

model credencial_qr {
  usuario_id Int       @id
  secreto    String    @db.VarChar(255)
  creada_at  DateTime  @default(now()) @db.Timestamptz(6)
  rotada_at  DateTime? @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model plan_membresia {
  id             Int     @id @default(autoincrement())
  nombre         String  @unique @db.VarChar(100)
  duracion_meses Int     @db.SmallInt
  precio         Decimal @db.Decimal(10, 2)

  membresia membresia[]
}

model membresia {
  id                    Int              @id @default(autoincrement())
  usuario_id            Int
  plan_id               Int
  fecha_inicio          DateTime         @db.Date
  fecha_fin             DateTime         @db.Date
  estado                estado_membresia @default(PENDIENTE_PAGO)
  renovacion_automatica Boolean          @default(false)
  creada_at             DateTime         @default(now()) @db.Timestamptz(6)

  usuario        usuario        @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_membresia plan_membresia @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pago           pago[]

  @@index([usuario_id], map: "ix_membresia_usuario_id")
  @@index([plan_id], map: "ix_membresia_plan_id")
}

model acceso {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  sede_id    Int
  ingreso_at DateTime  @default(now()) @db.Timestamptz(6)
  egreso_at  DateTime? @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sede    sede    @relation(fields: [sede_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sede_id], map: "ix_acceso_sede_id")
}

model tipo_clase {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(100)
  clase  clase[]
}

model instructor {
  id         Int     @id @default(autoincrement())
  usuario_id Int     @unique
  usuario    usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clase      clase[]
}

model clase {
  id               Int      @id @default(autoincrement())
  sede_id          Int
  tipo_clase_id    Int
  instructor_id    Int
  inicio_at        DateTime @db.Timestamptz(6)
  fin_at           DateTime @db.Timestamptz(6)
  capacidad_maxima Int      @db.SmallInt
  cupo_disponible  Int      @db.SmallInt

  sede               sede                 @relation(fields: [sede_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo_clase         tipo_clase           @relation(fields: [tipo_clase_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  instructor         instructor           @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reserva_clase      reserva_clase[]
  lista_espera_clase lista_espera_clase[]

  @@index([sede_id], map: "ix_clase_sede_id")
  @@index([tipo_clase_id], map: "ix_clase_tipo_clase_id")
  @@index([instructor_id], map: "ix_clase_instructor_id")
}

model reserva_clase {
  id           Int                  @id @default(autoincrement())
  usuario_id   Int
  clase_id     Int
  estado       estado_reserva_clase @default(CONFIRMADA)
  reservada_at DateTime             @default(now()) @db.Timestamptz(6)
  cancelada_at DateTime?            @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clase   clase   @relation(fields: [clase_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([clase_id], map: "ix_reserva_clase_clase_id")
}

model lista_espera_clase {
  id            Int                 @id @default(autoincrement())
  usuario_id    Int
  clase_id      Int
  estado        estado_lista_espera @default(EN_ESPERA)
  creada_at     DateTime            @default(now()) @db.Timestamptz(6)
  notificada_at DateTime?           @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clase   clase   @relation(fields: [clase_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([clase_id], map: "ix_lista_espera_clase_id")
}

model tipo_cancha {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(100)
  cancha cancha[]
}

model cancha {
  id             Int           @id @default(autoincrement())
  sede_id        Int
  tipo_cancha_id Int
  nombre         String        @db.VarChar(100)
  costo_hora     Decimal       @db.Decimal(10, 2)
  estado         estado_cancha @default(HABILITADA)

  sede           sede             @relation(fields: [sede_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo_cancha    tipo_cancha      @relation(fields: [tipo_cancha_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reserva_cancha reserva_cancha[]

  @@unique([sede_id, nombre])
  @@index([tipo_cancha_id], map: "ix_cancha_tipo_cancha_id")
}

model reserva_cancha {
  id           Int                   @id @default(autoincrement())
  cancha_id    Int
  usuario_id   Int
  fecha        DateTime              @db.Date
  hora_inicio  Int                   @db.SmallInt
  estado       estado_reserva_cancha @default(PENDIENTE_PAGO)
  precio_base  Decimal               @db.Decimal(10, 2)
  descuento    Decimal               @default(0) @db.Decimal(10, 2)
  recargo      Decimal               @default(0) @db.Decimal(10, 2)
  monto_total  Decimal               @db.Decimal(10, 2)
  creada_at    DateTime              @default(now()) @db.Timestamptz(6)
  cancelada_at DateTime?             @db.Timestamptz(6)

  cancha  cancha  @relation(fields: [cancha_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pago    pago[]

  @@index([usuario_id], map: "ix_reserva_cancha_usuario_id")
}

model pago {
  id                Int             @id @default(autoincrement())
  membresia_id      Int?
  reserva_cancha_id Int?
  monto             Decimal         @db.Decimal(10, 2)
  estado            estado_pago     @default(PENDIENTE)
  token_pasarela    String?         @db.VarChar(255)
  creado_at         DateTime        @default(now()) @db.Timestamptz(6)
  pagado_at         DateTime?       @db.Timestamptz(6)

  membresia      membresia?      @relation(fields: [membresia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reserva_cancha reserva_cancha? @relation(fields: [reserva_cancha_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comprobante    comprobante?

  @@index([membresia_id], map: "ix_pago_membresia_id")
  @@index([reserva_cancha_id], map: "ix_pago_reserva_cancha_id")
}

model comprobante {
  id          Int      @id @default(autoincrement())
  pago_id     Int      @unique
  emitido_at  DateTime @default(now()) @db.Timestamptz(6)
  archivo_url String   @db.Text

  pago pago @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
