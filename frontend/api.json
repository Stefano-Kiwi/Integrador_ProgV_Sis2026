{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Devuelve la página de inicio"
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/usuarios": {
      "get": {
        "description": "Retorna todos los usuarios registrados (sin hash de contraseña)",
        "operationId": "UsersController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Listado de usuarios obtenido correctamente"
          }
        },
        "summary": "Listar usuarios",
        "tags": [
          "usuarios"
        ]
      },
      "post": {
        "description": "Registra un nuevo usuario en la base de datos",
        "operationId": "UsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente"
          }
        },
        "summary": "Crear usuario",
        "tags": [
          "usuarios"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credenciales correctas: devuelve el JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Body inválido (email mal formado, campos faltantes)"
          },
          "401": {
            "description": "Credenciales inválidas (mensaje genérico)"
          }
        },
        "summary": "Iniciar sesión con email y contraseña",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Devuelve los datos del usuario identificado por el JWT, incluyendo su rol.",
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Datos del usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido o no enviado"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Perfil del usuario autenticado",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/verify": {
      "post": {
        "description": "El frontend envía los roles requeridos para una página. Devuelve 200 si el usuario tiene uno de esos roles, 403 si no. Siempre requiere un JWT válido (401 si no se envía).",
        "operationId": "AuthController_verify",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRolDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "El usuario tiene permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido o no enviado"
          },
          "403": {
            "description": "El usuario no tiene el rol requerido"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Verificar si el usuario tiene permiso para acceder a una página",
        "tags": [
          "auth"
        ]
      }
    },
