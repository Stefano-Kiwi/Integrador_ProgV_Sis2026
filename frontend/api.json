  "info": {
    "title": "FitZone Sports API",
    "description": "Documentación de la API de FitZone Sports",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "dni": {
            "type": "string",
            "maxLength": 20,
            "example": "30123456"
          },
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "example": "Carlos"
          },
          "apellido": {
            "type": "string",
            "maxLength": 100,
            "example": "Gómez"
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "format": "email",
            "example": "carlos@fitzone.com"
          },
          "telefono": {
            "type": "string",
            "maxLength": 30,
            "example": "1155551234"
          },
          "foto_url": {
            "type": "string",
            "example": "https://fitzone.com/fotos/perfil-1.jpg"
          },
          "id_rol": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID de rol (1: Cliente, 2: Instructor, 3: Gerente)"
          },
          "sede_base_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID de la sede asignada como sede base"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "MiClaveSegura1"
          }
        },
        "required": [
          "dni",
          "nombre",
          "apellido",
          "email",
          "id_rol",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 150,
            "format": "email",
            "example": "ana@fitzone.com"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "example": "MiClaveSegura1"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT para usar como Bearer token",
            "example": "eyJhbGciOi..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "dni": {
            "type": "string",
            "example": "30123456"
          },
          "nombre": {
            "type": "string",
            "example": "Carlos"
          },
          "apellido": {
            "type": "string",
            "example": "Gómez"
          },
          "email": {
            "type": "string",
            "example": "carlos@fitzone.com"
          },
          "rol": {
            "type": "object",
            "properties": {
              "id_rol": {
                "type": "number"
              },
              "clase_rol": {
                "type": "string"
              }
            },
            "required": [
              "id_rol",
              "clase_rol"
            ]
          },
          "sede_base": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "nombre": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "nombre"
            ]
          }
        },
        "required": [
          "id",
          "dni",
          "nombre",
          "apellido",
          "email",
          "rol"
        ]
      },
      "VerifyRolDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "Cliente",
                "Instructor",
                "Gerente",
                "Administrador"
              ]
            },
            "description": "Lista de roles que pueden acceder a la página. Se aprueba si el usuario tiene AL MENOS uno.",
            "example": [
              "Gerente",
              "Administrador"
            ]
          }
        },
        "required": [
          "roles"
        ]
      },
      "VerifyResponseDto": {
        "type": "object",
        "properties": {
          "autorizado": {
            "type": "boolean",
            "example": true
          },
          "rol_usuario": {
            "type": "string",
            "example": "Cliente"
          },
          "roles_requeridos": {
            "example": [
              "Gerente",
              "Administrador"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "autorizado",
          "rol_usuario",
          "roles_requeridos"
        ]
      },
      "CreateSedeDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 150,
            "example": "FitZone Concordia Centro"
          },
          "direccion": {
            "type": "string",
            "maxLength": 200,
            "example": "Av. Siempre Viva 123"
          },
          "localidad": {
            "type": "string",
            "maxLength": 100,
            "example": "Concordia"
          },
          "aforo_maximo": {
            "type": "number",
            "minimum": 1,
            "example": 80,
            "description": "Capacidad de aforo máximo permitido"
          }
        },
        "required": [
          "nombre",
          "direccion",
          "localidad",
          "aforo_maximo"
        ]
      },
      "CreatePlanDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "example": "Mensual"
          },
          "duracion_meses": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "Duración en meses"
          },
          "precio": {
            "type": "number",
            "minimum": 1,
            "example": 15000,
            "description": "Precio del plan"
          }
        },
        "required": [
          "nombre",
          "duracion_meses",
          "precio"
        ]
      },
      "CreateClaseDto": {
        "type": "object",
        "properties": {
          "sede_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID de la sede donde se dictará la clase"
          },
          "tipo_clase_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID del tipo de clase (Spinning, Yoga, etc.)"
          },
          "instructor_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID del instructor que dicta la clase"
          },
          "inicio_at": {
            "type": "string",
            "example": "2026-09-29T18:00:00Z",
            "description": "Fecha y hora de inicio"
          },
          "fin_at": {
            "type": "string",
            "example": "2026-09-29T19:00:00Z",
            "description": "Fecha y hora de finalización"
          },
          "capacidad_maxima": {
            "type": "number",
            "minimum": 1,
            "example": 20,
            "description": "Capacidad máxima de alumnos"
          }
        },
        "required": [
          "sede_id",
          "tipo_clase_id",
          "instructor_id",
          "inicio_at",
          "fin_at",
          "capacidad_maxima"
        ]
      },
      "ReservaClaseDto": {
        "type": "object",
        "properties": {
          "clase_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID de la clase a reservar"
          },
          "usuario_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID del usuario que realiza la reserva"
          }
        },
        "required": [
          "clase_id",
          "usuario_id"
        ]
      },
      "CreateCanchaDto": {
        "type": "object",
        "properties": {
          "tipo_cancha_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID del tipo de cancha (paddle, fútbol, etc.)"
          },
          "sede_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID de la sede donde se ubica"
          },
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "example": "Cancha 1 (Paddle)"
          },
          "costo_hora": {
            "type": "number",
            "minimum": 1,
            "example": 8000,
            "description": "Costo por hora de alquiler"
          }
        },
        "required": [
          "tipo_cancha_id",
          "sede_id",
          "nombre",
          "costo_hora"
        ]
      },
      "ReservaCanchaDto": {
        "type": "object",
        "properties": {
          "cancha_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID de la cancha a reservar"
          },
          "usuario_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID del usuario que realiza la reserva"
          },
          "fecha": {
            "type": "string",
            "example": "2026-10-30",
            "description": "Fecha de reserva (YYYY-MM-DD)"
          },
          "hora_inicio": {
            "type": "number",
            "minimum": 0,
            "maximum": 23,
            "example": 18,
            "description": "Hora de inicio (0 a 23)"
          }
        },
        "required": [
          "cancha_id",
          "usuario_id",
          "fecha",
          "hora_inicio"
        ]
      },
      "SimularPagoDto": {
        "type": "object",
        "properties": {
          "origen_tipo": {
            "enum": [
              "membresia",
              "cancha"
            ],
            "type": "string",
            "example": "cancha",
            "description": "Origen del pago: membresia o cancha"
          },
          "origen_id": {
            "type": "number",
            "minimum": 1,
            "example": 1,
