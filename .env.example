# Variables de entorno para Docker Compose (sin secretos reales)
# Copiar a .env antes de levantar si querés personalizar valores.

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=fitzone_sports

# Backend NestJS
PORT=3000
DATABASE_URL="postgresql://postgres:change_me_postgres_password@localhost:5432/fitzone_sports?schema=public"

# Seguridad (reemplazar por cadenas aleatorias seguras en producción)
JWT_SECRET=change_me_jwt_secret
QR_SECRET=change_me_qr_secret
